  },
  {
    "id": "code",
    "name": "代码",
    "extensions": [".go", ".py", ".pyw", ".js", ".mjs", ".cjs", ".jsx", ".ts", ".tsx", ".c", ".h", ".cc", ".cpp", ".cxx", ".hpp", ".hxx", ".cs", ".java", ".kt", ".kts", ".rs", ".rb", ".php", ".swift", ".lua", ".r", ".sql", ".html", ".htm", ".xhtml", ".xml", ".xsd", ".xsl", ".xslt", ".svg", ".css", ".scss", ".sass", ".less", ".vue", ".svelte"]
  },
  {
    "id": "data",
    "name": "数据",
    "extensions": [".json", ".jsonc", ".json5", ".jsonl", ".ndjson", ".csv", ".tsv"]
  },
  {
    "id": "config",
    "name": "配置",
